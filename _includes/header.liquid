{% assign current_language = page.lang | default: site.lang %}
{% if current_language == 'zh' %}
  {% assign home_url = '/zh/' %}
  {% assign home_title = '首页' %}
  {% assign other_language = 'en' %}
  {% assign switch_label = 'English' %}
{% else %}
  {% assign home_url = '/' %}
  {% assign home_title = 'Home' %}
  {% assign other_language = 'zh' %}
  {% assign switch_label = '中文' %}
{% endif %}
{% assign alternate = site.pages | concat: site.projects | where: 'translation_key', page.translation_key | where: 'lang', other_language | first %}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-site {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.translation_key != 'home' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {% if current_language == 'zh' %}廖文杰{% else %}{{- site.title -}}{% endif %}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      {% if alternate %}
      <a class="language-switch" href="{{ alternate.url | relative_url }}" hreflang="{% if other_language == 'zh' %}zh-CN{% else %}en{% endif %}" lang="{% if other_language == 'zh' %}zh-CN{% else %}en{% endif %}" aria-label="{% if current_language == 'zh' %}切换到当前页面的英文版{% else %}Read this page in Chinese{% endif %}">{{ switch_label }}</a>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{% if current_language == 'zh' %}展开或收起导航{% else %}Toggle navigation{% endif %}"
      >
        <span class="sr-only">{% if current_language == 'zh' %}展开或收起导航{% else %}Toggle navigation{% endif %}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <!-- About -->
          <li class="nav-item {% if page.translation_key == 'home' %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- home_title }}
              {% if page.translation_key == 'home' %}
                <span class="sr-only">{% if current_language == 'zh' %}（当前页面）{% else %}(current){% endif %}</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_language = p.lang | default: site.lang %}
            {% if p.nav and p.autogen == null and p_language == current_language %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">{% if current_language == 'zh' %}（当前页面）{% else %}(current){% endif %}</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">{% if current_language == 'zh' %}（当前页面）{% else %}(current){% endif %}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="{% if current_language == 'zh' %}切换配色{% else %}Change theme{% endif %}" aria-label="{% if current_language == 'zh' %}切换明暗配色{% else %}Change color theme{% endif %}">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
